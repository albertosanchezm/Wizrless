[sub_resource type="Shader" id="Shader_bar_vertical_highlight"]
code = "shader_type canvas_item;\n\nuniform float top_brightness = 0.12;\nuniform float bottom_darkness = 0.18;\n\nvoid fragment() {\n\tvec4 base = COLOR;\n\tfloat highlight = mix(top_brightness, 0.0, UV.y);\n\tfloat shadow = mix(0.0, bottom_darkness, UV.y);\n\tbase.rgb = clamp(base.rgb + vec3(highlight - shadow), vec3(0.0), vec3(1.0));\n\tCOLOR = base;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bar_vertical_highlight"]
